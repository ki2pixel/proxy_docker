# ==============================================================================
# Modèle de Configuration : Multi-Fournisseurs de Monétisation Docker & Passerelle ISP
# ==============================================================================

# Port d'accès au Dashboard Web sur votre machine hôte (par défaut 8088)
DASHBOARD_PORT=8088

# Port local de test SOCKS5 (bridge socat vers le proxy actif)
SOCKS_PORT=23321

# Profil(s) de monétisation actif(s) au démarrage de docker compose
# Choix possibles : proxyrack | honeygain | packetstream | pawns | repocket | all
COMPOSE_PROFILES="repocket"

# ==============================================================================
# Passerelle Dédiée Static ISP / Residential (FlameProxies, PrivateProxy, etc.)
# ==============================================================================
ISP_PROXY_PROTOCOL="socks5"
ISP_PROXY_HOST="194.70.234.170"
ISP_PROXY_PORT="1085"
ISP_PROXY_USER=""
ISP_PROXY_PASS=""
GATEWAY_LOGLEVEL="warn"

# Rotation Automatique de session résidentielle (Failover automatique + Préventif)
AUTO_ROTATE_SESSION="true"
AUTO_ROTATE_INTERVAL="50"

# ==============================================================================
# 1. Fournisseur : Proxyrack (https://peer.proxyrack.com)
# ==============================================================================
API_KEY="votre_api_key_proxyrack"
UUID=""
DEVICE_NAME="Docker-ISP-Proxyrack"

# ==============================================================================
# 2. Fournisseur : Honeygain (https://dashboard.honeygain.com)
# ==============================================================================
HONEYGAIN_EMAIL="votre_email_honeygain@example.com"
HONEYGAIN_PASSWORD="votre_mot_de_passe_honeygain"
HONEYGAIN_DEVICE_NAME="Docker-ISP-Honeygain"

# ==============================================================================
# 3. Fournisseur : PacketStream (https://packetstream.io)
# ==============================================================================
PACKETSTREAM_CID="votre_cid_packetstream"

# ==============================================================================
# 4. Fournisseur : Pawns.app / IPRoyal (https://pawns.app)
# ==============================================================================
PAWNS_EMAIL="votre_email_pawns@example.com"
PAWNS_PASSWORD="votre_mot_de_passe_pawns"
PAWNS_DEVICE_NAME="Docker-ISP-Pawns"

# ==============================================================================
# 5. Fournisseur : Repocket (https://repocket.com)
# ==============================================================================
REPOCKET_EMAIL="votre_email_repocket@example.com"
REPOCKET_API_KEY="votre_api_key_repocket"


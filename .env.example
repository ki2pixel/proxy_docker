# ==============================================================================
# Modèle de Configuration : Multi-Fournisseurs de Monétisation Docker & Passerelle ISP
# Copiez ce fichier vers .env puis REMPLACEZ TOUTES les valeurs CHANGEME_*
# Le démarrage est refusé si des placeholders restent présents.
# ==============================================================================

# Port d'accès au Dashboard Web sur votre machine hôte (par défaut 8088)
# ⚠️ Le dashboard n'est plus exposé publiquement : accédez-y via tunnel SSH :
#    ssh -L 8088:localhost:8088 azureuser@<IP>
DASHBOARD_PORT=8088

# Profil(s) de monétisation actif(s) au démarrage de docker compose
# Choix possibles : proxyrack | honeygain | packetstream | pawns | repocket | all
COMPOSE_PROFILES="repocket"

# ==============================================================================
# Sécurité du Dashboard (OBLIGATOIRE — le conteneur refuse de démarrer sinon)
# Générez-les avec : openssl rand -hex 32
# ==============================================================================
# Token de connexion au dashboard (envoyé sur /api/login)
DASHBOARD_TOKEN="CHANGEME_openssl_rand_hex_32"
# Secret HMAC de signature des cookies de session
DASHBOARD_SECRET="CHANGEME_openssl_rand_hex_32"

# ==============================================================================
# Passerelle Dédiée Static ISP / Residential (FlameProxies, PrivateProxy, etc.)
# ==============================================================================
ISP_PROXY_PROTOCOL="socks5"
ISP_PROXY_HOST="CHANGEME_proxy.example.com"
ISP_PROXY_PORT="1080"
ISP_PROXY_USER=""
ISP_PROXY_PASS=""
GATEWAY_LOGLEVEL="warn"

# Rotation Automatique de session résidentielle
# Failover : géré par le watchdog du gateway (toujours actif)
# Préventif : géré par le controller (intervalle en minutes, 0 = désactivé)
AUTO_ROTATE_SESSION="true"
AUTO_ROTATE_INTERVAL="50"

# ==============================================================================
# 1. Fournisseur : Proxyrack (https://peer.proxyrack.com)
# ==============================================================================
API_KEY="CHANGEME_api_key_proxyrack"
UUID=""
DEVICE_NAME="Docker-ISP-Proxyrack"

# ==============================================================================
# 2. Fournisseur : Honeygain (https://dashboard.honeygain.com)
# ==============================================================================
HONEYGAIN_EMAIL="CHANGEME_email_honeygain"
HONEYGAIN_PASSWORD="CHANGEME_mot_de_passe_honeygain"
HONEYGAIN_DEVICE_NAME="Docker-ISP-Honeygain"

# ==============================================================================
# 3. Fournisseur : PacketStream (https://packetstream.io)
# ==============================================================================
PACKETSTREAM_CID="CHANGEME_cid_packetstream"

# ==============================================================================
# 4. Fournisseur : Pawns.app / IPRoyal (https://pawns.app)
# ==============================================================================
PAWNS_EMAIL="CHANGEME_email_pawns"
PAWNS_PASSWORD="CHANGEME_mot_de_passe_pawns"
PAWNS_DEVICE_NAME="Docker-ISP-Pawns"

# ==============================================================================
# 5. Fournisseur : Repocket (https://repocket.com)
# ==============================================================================
REPOCKET_EMAIL="CHANGEME_email_repocket"
REPOCKET_API_KEY="CHANGEME_api_key_repocket"

# ==============================================================================
# Optionnel : exposition publique chiffrée du dashboard via Caddy (profil "tls")
# COMPOSE_PROFILES="tls" + DASHBOARD_DOMAIN="dashboard.example.com"
# ==============================================================================
DASHBOARD_DOMAIN=""
